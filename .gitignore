node_modules/
release/
# Any build output directory, not just the default one. Building to a scratch
# name like release-new/ is the way around a Windows file lock left on a stale
# artifact, and that must not become a 90 MB commit.
release-*/
dist/

# Dev artifacts
*.log
.DS_Store
Thumbs.db

# Local screenshots produced while developing
/shot-*.png
/app-*.png

# Fixture written by the clipboard checks, regenerated on every run
/tools/.copy-sample.png

# docs/ holds development captures of the running app. Those show real contact
# names, phone numbers, private message text and a private server URL, so they
# stay on this machine and are never published. Only the synthetic sheet of
# hand-drawn network glyphs - which contains no user data - is committed.
# Note the `/docs/*` form: excluding the directory itself would make the
# negation below unreachable.
/docs/*
!/docs/network-glyphs.png

# Generated from index.html by check:historyrender, check:sidebar,
# check:threadopen, check:paste and check:notificationclick on every run
/tools/.history-render-harness.html
/tools/.sidebar-check-harness.html
/tools/.thread-open-harness.html
/tools/.paste-harness.html
/tools/.notification-click-harness.html

# Copied in by tools/download-shot.js to render a real video; not part of the repo
/tools/.shot-video.mp4

# Built by `npm run build:helper` from tools/update-helper. Regenerated, never
# committed: it is a 60 MB binary and it is built by the same pipeline that
# packages the installer.
/build/update-helper/
/tools/update-helper/bin/
/tools/update-helper/obj/
