{
  "name": "better-beeper",
  "productName": "Better Beeper",
  "version": "1.10.0",
  "private": true,
  "description": "A desktop chat client for Beeper, built on the Beeper Desktop REST API, WebSocket events, and the built-in MCP server.",
  "main": "src/main/main.js",
  "author": "Scott Yates",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "node tools/dist.js",
    "dist:only": "node tools/dist.js --no-install",
    "dist:scratch": "electron-builder --win --x64 --config.directories.output=release-scratch --publish=never",
    "deploy": "node tools/install-update.js",
    "deploy:check": "node tools/install-update.js --check",
    "check:notify": "node tools/notify-check.js",
    "check:send": "electron tools/send-check.js",
    "check:rich": "electron tools/rich-text-check.js",
    "check:pin": "electron tools/pin-check.js",
    "check:archive": "electron tools/archive-check.js",
    "check:layout": "electron tools/layout-check.js",
    "check:icons": "node tools/icon-check.mjs",
    "check:ascii": "node tools/ascii-check.js",
    "check:unread": "electron tools/unread-check.js",
    "check:update": "node tools/update-check.js",
    "check:syntax": "node tools/syntax-check.js",
    "check:released": "node tools/released-check.js",
    "check:composer": "electron tools/composer-check.js",
    "check:bump": "node tools/bump-check.js",
    "check:live": "node tools/live-send.js",
    "release": "node tools/release.js",
    "pack": "electron-builder --dir",
    "check:paste": "electron tools/paste-check.js",
    "check:paste-live": "node tools/paste-live.js",
    "check:api": "node tools/api-surface-check.js",
    "check:settings": "node tools/settings-check.js",
    "check:imagecopy": "node tools/image-copy-check.js",
    "check:imagecopy-live": "node tools/image-copy-live.js",
    "check:gif": "electron tools/gif-check.js",
    "check:visibility": "electron tools/visibility-check.js",
    "check:gifrebuild": "electron tools/gif-rebuild-check.js",
    "check:about": "electron tools/about-check.js",
    "check:actions": "electron tools/actions-check.js",
    "check:installer": "node tools/installer-check.js",
    "check:media": "electron tools/media-check.js",
    "check:history": "node tools/history-check.js",
    "check:historyrender": "electron tools/history-render-check.js",
    "media:rename": "node tools/rename-media-ext.js",
    "check:mediafolder": "node tools/media-folder-check.js",
    "media:prune": "node tools/prune-media.js"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "ws": "^8.22.0"
  }
}
